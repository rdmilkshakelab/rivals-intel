{
  "expo": {
    "name": "Rivals Intel",
    "slug": "rivals-intel",
    "scheme": "rivalsintel",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Rivals Intel to scan device sign-in QR codes."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "baseUrl": "/rivals-intel"
    },
    "android": {
      "package": "com.rdmilkeshakelab.rivalsintel"
    },
    "ios": {
      "bundleIdentifier": "com.rdmilkeshakelab.rivalsintel"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    }
  }
}
