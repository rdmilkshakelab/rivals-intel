{
  "name": "rivals-intel-macos",
  "version": "0.1.0",
  "description": "Rivals Intel for macOS",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac dmg zip --universal"
  },
  "devDependencies": {
    "electron": "^40.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.rdmilkeshakelab.rivalsintel",
    "productName": "Rivals Intel",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.utilities",
      "artifactName": "Rivals-Intel-macOS-${version}-${arch}.${ext}"
    },
    "dmg": {
      "sign": false
    }
  }
}
