PORT=4000
MARVEL_RIVALS_API_KEY=replace_me
# Comma-separated exact browser origins. Do not use * when credentials are enabled.
ALLOWED_ORIGIN=http://localhost:8081,http://localhost:19006
# PostgreSQL connection string. Accounts/device pairing require a persistent database.
DATABASE_URL=postgresql://username:password@host:5432/rivals_intel
DATABASE_SSL=true
# Generate with: openssl rand -base64 32
AUTH_ENCRYPTION_KEY=replace_with_base64_32_byte_key
# Public web origin used in TV/device activation screens.
PUBLIC_WEB_URL=https://rivalsintel.com
